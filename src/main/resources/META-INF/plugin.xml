<idea-plugin>
    <id>com.chuntung.plugin.mybatisbuilder</id>
    <name>MyBatis Builder</name>
    <version>1.0</version>
    <vendor email="ho@chuntung.com" url="https://mybatis.chuntung.com">Chuntung Ho</vendor>

    <description><![CDATA[
    <p>A free GUI plugin that integrates <b>MyBatis Generator</b> into IntelliJ IDEA, with bidirectional
    navigation between Mapper interfaces and XML files.</p>

    <p><b>Supported databases:</b> MySQL, PostgreSQL, MariaDB, Oracle, SQL Server, SQLite, H2</p>

    <p><b>Features:</b></p>
    <ul>
      <li>Generate MyBatis boilerplate via a graphical wizard.</li>
      <li>Navigate between Mapper interface methods and XML statements (gutter icons &amp; references).</li>
      <li>Validate <code>parameterType</code> / <code>resultType</code> against mapper method signatures.</li>
      <li>Generate XML statement stubs from mapper methods (quick-fix intention).</li>
      <li>Merge existing MyBatis files automatically on re-generation.</li>
      <li>Select-with-lock statement support (<code>FOR UPDATE</code> / <code>LOCK IN SHARE MODE</code>).</li>
      <li>Lombok <code>@Data</code> annotation on generated Java models.</li>
      <li>Customizable mapper annotation (default: Spring <code>@Repository</code>).</li>
      <li>Customizable naming patterns for mapper type, example type and SQL file name.</li>
      <li><i>Copy as Executable SQL</i> — reconstructs a runnable SQL from MyBatis log output.</li>
      <li><i>Run MyBatis Generator</i> — execute MBG directly from a <code>generator-config.xml</code> file.</li>
    </ul>

    <p><a href="https://mybatis.chuntung.com">Getting Started</a></p>
    ]]></description>

    <change-notes><![CDATA[
        A GUI tool integrated with mybatis generator.
    ]]>
    </change-notes>

    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/build_number_ranges.html for description -->
<!--    <idea-version since-build="191.0"/>-->

    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <!--uncomment to enable plugin in all products-->
    <depends>com.intellij.modules.java</depends>

    <actions>
        <!-- Manage -->
        <action id="MyBatisBuilder.Manage"
                class="com.chuntung.plugin.mybatis.builder.action.idea.ManageAction"/>

        <!-- Build -->
        <action id="MyBatisBuilder.Build"
                class="com.chuntung.plugin.mybatis.builder.action.idea.BuildAction"/>

        <!-- New MyBatis Generator Config-->
        <action id="MyBatisBuilder.NewConfiguration"
                class="com.chuntung.plugin.mybatis.builder.action.idea.NewMyBatisGeneratorConfigAction">
            <add-to-group group-id="NewGroup" relative-to-action="NewFromTemplate" anchor="after"/>
        </action>

        <!-- Run MyBatis Generator popup menu -->
        <group id="ProjectViewPopupMenuMyBatisBuilderGroup">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="before"
                          relative-to-action="ProjectViewPopupMenuRunGroup"/>
            <action id="MyBatisBuilder.RunMyBatisGenerator" text="Run MyBatis Generator" icon="/images/popupMenuMybatis.svg"
                    description="Run MyBatis Generator with selected configuration file"
                    class="com.chuntung.plugin.mybatis.builder.action.idea.RunMyBatisGeneratorAction"/>
        </group>

        <!-- Copy as Executable SQL popup menu -->
        <action id="MyBatisBuilder.CopyAsExecutableSQL" text="Copy as Executable SQL"
                description="Copy selection in MyBatis log (keywords 'Preparing: ' and 'Parameters: ' are required) as Executable SQL to clipboard"
                class="com.chuntung.plugin.mybatis.builder.action.idea.CopyAsExecutableSQLAction">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="CopyAsPlainText"/>
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="after" relative-to-action="CutCopyPasteGroup"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- tool window -->
        <toolWindow id="MyBatis Builder"
                    anchor="left" secondary="true"
                    factoryClass="com.chuntung.plugin.mybatis.builder.view.MybatisBuilderToolWindowFactory"/>

        <!-- file template provider -->
        <fileTemplateGroup implementation="com.chuntung.plugin.mybatis.builder.MyBatisBuilderFileTemplateProvider"/>

        <!-- application state -->
        <applicationService serviceImplementation="com.chuntung.plugin.mybatis.builder.MyBatisBuilderConfigManager"/>

        <!-- project state -->
        <projectService serviceImplementation="com.chuntung.plugin.mybatis.builder.MybatisBuilderSettingsManager"/>

        <!-- core project service -->
        <projectService serviceImplementation="com.chuntung.plugin.mybatis.builder.MybatisBuilderService" />

        <!-- notification group, since 203.3645.34 -->
        <notificationGroup id="MyBatisBuilder.NotificationGroup" displayType="BALLOON" isLogByDefault="true" />

        <!-- Mapper <-> XML gutter line markers -->
        <codeInsight.lineMarkerProvider language="JAVA"
            implementationClass="com.chuntung.plugin.mybatis.builder.view.MapperToXmlLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="XML"
            implementationClass="com.chuntung.plugin.mybatis.builder.view.XmlToMapperLineMarkerProvider"/>

        <!-- Mapper XML <-> Java cross-language references -->
        <psi.referenceContributor language="XML"
            implementation="com.chuntung.plugin.mybatis.builder.reference.MapperNamespaceReferenceContributor"/>

        <!-- Quick-fix: generate XML statement stub from a mapper method -->
        <intentionAction>
            <className>com.chuntung.plugin.mybatis.builder.action.idea.GenerateXmlStatementIntention</className>
            <category>MyBatis Builder</category>
            <descriptionDirectoryName>GenerateXmlStatementIntention</descriptionDirectoryName>
        </intentionAction>

        <!-- Annotator: validate parameterType / resultType against the mapper method -->
        <annotator language="XML"
            implementationClass="com.chuntung.plugin.mybatis.builder.annotator.MapperTypeAnnotator"/>
    </extensions>

</idea-plugin>
